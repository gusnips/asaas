{
  "name": "@gusnips/asaas",
  "packageManager": "bun@1.4.4",
  "version": "2.2.2",
  "description": "Unofficial TypeScript SDK for Asaas API with domain-based architecture",
  "repository": {
    "type": "git",
    "url": "https://github.com/gusnips/asaas.git"
  },
  "homepage": "https://github.com/gusnips/asaas#readme",
  "bugs": {
    "url": "https://github.com/gusnips/asaas/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build",
    "release": "npm publish --access public",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "keywords": [
    "asaas",
    "payment",
    "sdk",
    "typescript",
    "api-client",
    "pagamento"
  ],
  "author": "Gustavo Salomé (gusnips)",
  "license": "MIT",
  "devDependencies": {
    "@gusnips/oxlint": "^0.2.0",
    "@types/bun": "latest",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.12.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}
